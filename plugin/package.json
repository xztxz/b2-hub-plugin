{
  "name": "@local/b2-hub",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "B2 notes/tasks hub: read and write the B2 markdown library from DSH, with a sidebar panel.",
  "scripts": {
    "test": "node --test test/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
